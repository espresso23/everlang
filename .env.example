# Copy to .env; generate secrets locally. Never commit .env.
POSTGRES_PASSWORD=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
KRDICT_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EverLang <hello@everlang.local>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_CLOUD_PROJECT=
# Container path to a read-only service-account JSON mount configured locally.
GOOGLE_APPLICATION_CREDENTIALS=
EVERLANG_DOMAIN=
LOG_LEVEL=info
# Optional CPU ASR; run Docker profile speech after reading feature setup docs.
SPEECH_PROVIDER=disabled
SPEECH_THREADS=2
# Docker supplies the private volume root and readonly model mount.
# For host-only development, explicitly set SPEECH_MEDIA_ROOT and WHISPER_MODEL_PATH.

# Speech API option: Gemini project Free tier, billing disabled; key server-only.
# SPEECH_PROVIDER=gemini (alternative: whispercpp; default disabled)
GEMINI_API_KEY=
# API budget20/day UTC is a local guard, not a billing-tier detector.
PUBLIC_ORIGIN=http://localhost:3000
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
CSRF_SECRET=
