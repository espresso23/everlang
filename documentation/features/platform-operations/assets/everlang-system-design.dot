digraph EverLang {
  graph [rankdir=LR, bgcolor="#F4F4F2", pad="0.45", nodesep="0.3", ranksep="0.65", splines=spline, compound=true,
    fontname="Segoe UI", fontsize=24, labelloc=t,
    label="EverLang — System Design\nNative NestJS backend · Code snapshot 686d87c · 2026-11-01"];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#244CE0", penwidth=1.5,
    fontname="Segoe UI", fontsize=15, margin="0.17,0.12", fontcolor="#111111"];
  edge [color="#244CE0", penwidth=1.5, arrowsize=0.8, fontname="Segoe UI", fontsize=12, fontcolor="#1838AE"];

  subgraph cluster_entry {
    label="01  CLIENT & ENTRY"; fontsize=18; color="#BAC7EF"; style="rounded,filled"; fillcolor="#EEF1FF";
    browser [label="Browser\nLearner / Admin\n\nAccess JWT in RAM\nHttpOnly refresh cookie"];
    gateway [label="Caddy gateway\nSame-origin routing\n\nLocal :3000\nProduction: HTTPS front proxy"];
    browser -> gateway [label="HTTP(S) requests", dir=both];
  }
  subgraph cluster_application {
    label="02  APPLICATION"; fontsize=18; color="#BAC7EF"; style="rounded,filled"; fillcolor="#EEF1FF";
    web [label="Next.js Web :3001\napps/web · UI only\n\nHTML / JS / assets"];
    api [label="NestJS API :4000\napps/api\n\nJWT guard · RBAC · Ownership\nAuth / Learning / Content / Exams\nGlobal exception filter\nRequest logging", fillcolor="#244CE0", fontcolor=white];
    {rank=same; web; api;}
  }
  subgraph cluster_data {
    label="03  DATA & JOB QUEUES"; fontsize=18; color="#A6D4CC"; style="rounded,filled"; fillcolor="#F0F9F7";
    node [color="#207F76", fillcolor="#FFFFFF"];
    pg [shape=cylinder, label="PostgreSQL + pgvector\n\nUsers / Sessions / Refresh hashes\nProgress / FSRS / Review logs\nDurable jobs / Reports / Tutor vectors"];
    mongo [shape=cylinder, label="MongoDB\n\nVersioned system content\nSentences / Exams / Knowledge / Catalogue"];
    redis [shape=cylinder, label="Redis + BullMQ\n\nCache / Rate limits\neverlang-grading\neverlang-speech\nNot the durable progress store"];
    media [shape=folder, label="Private speech_media volume\n\nUploaded audio\nAPI + speech worker access\nBrowser playback via owner-only API"];
    {rank=same; pg; mongo; redis; media;}
  }
  subgraph cluster_workers {
    label="04  ASYNC PROCESSING"; fontsize=18; color="#BAC7EF"; style="rounded,filled"; fillcolor="#EEF1FF";
    grading [label="Nest Grading Worker\napps/worker · GradingProcessor\n\neverlang-grading\nPersist report / failure in PG"];
    speech [label="Nest Speech Worker [optional]\napps/worker · SpeechProcessor\n\neverlang-speech\nffmpeg + selected ASR\nPersist transcript / status in PG", style="rounded,filled,dashed"];
    {rank=same; grading; speech;}
  }
  subgraph cluster_integrations {
    label="05  CONFIGURED INTEGRATIONS\nAvailability / live verification varies";
    fontsize=18; color="#D89636"; style="rounded,filled,dashed"; fillcolor="#FFF8EA";
    node [color="#B7771E", style="rounded,filled,dashed", fillcolor=white];
    openrouter [label="OpenRouter\nGrading / Tutor / AI drafts"];
    asr [label="Whisper.cpp OR Gemini\nSpeech transcription\n\nWhisper.cpp = local CPU\nGemini = cloud API\nOne provider profile at a time"];
    support [label="API integrations [optional]\n\nGoogle OAuth: sign-in / linking\nSMTP / Mailpit: verify / reset\nKRdict: dictionary\nS3 + Google STT: recordings"];
    {rank=same; openrouter; asr; support;}
  }

  gateway -> web [label="/  UI routes", dir=both];
  gateway -> api [label="/api/*  JSON + Bearer\nRefresh cookie: /api/auth only", dir=both];
  api -> pg [label="SQL · user-scoped reads / writes", dir=both];
  api -> mongo [label="Content reads / writes", dir=both];
  api -> redis [label="Cache / rate limit / enqueue"];
  api -> media [label="Upload / authorized audio read", dir=both];
  redis -> grading [label="Consume grading jobs"];
  redis -> speech [label="Consume speech jobs"];
  grading -> pg [label="Read job snapshot / write result", constraint=false];
  speech -> pg [label="Read attempt / write result", constraint=false];
  speech -> media [label="Read audio / cleanup", dir=both, constraint=false];

  edge [style=dashed, color="#B7771E", fontcolor="#855817"];
  grading -> openrouter [label="AI grading", dir=both];
  speech -> asr [label="ASR call", dir=both];
  api -> openrouter [label="Tutor / AI drafts (sync)"];
  api -> support [label="OAuth / email / dictionary / recordings"];

  // Shared packages are code imports, not network services.
  // Detailed AUTH / GRADING / SPEECH walkthroughs live in shared/architecture.md.
}
