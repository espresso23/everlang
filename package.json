{
  "name": "everlang",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:backend && npm run build -w @everlang/api && npm run build -w @everlang/worker && node --env-file=.env scripts/dev.mjs",
    "build": "npm run build:backend && npm run build -w @everlang/api && npm run build -w @everlang/worker && npm run build -w @everlang/web",
    "start": "node scripts/gateway.mjs",
    "lint": "eslint",
    "seed:extract": "python scripts/extract-seed.py",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "node apps/worker/dist/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-documentation.mjs",
    "docs:sync": "node scripts/check-documentation.mjs --refresh",
    "plan:check": "node scripts/planning.mjs",
    "plan:sync": "node scripts/planning.mjs --write",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts",
    "speech:worker": "WORKER_KIND=speech node apps/worker/dist/main.js",
    "speech:model": "node scripts/download-speech-model.mjs",
    "seed:vocabulary": "tsx scripts/seed-vocabulary-catalog.ts",
    "build:backend": "npm run build -w @everlang/contracts && npm run build -w @everlang/backend",
    "typecheck": "npm run build:backend && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "records:import": "tsx scripts/import-records.ts",
    "backend:check": "node scripts/check-backend-boundary.mjs",
    "auth:keys": "node scripts/init-auth-keys.mjs"
  },
  "dependencies": {
    "@everlang/backend": "*",
    "@everlang/contracts": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "@types/express": "^5.0.6",
    "@types/cookie-parser": "^1.4.10"
  }
}
