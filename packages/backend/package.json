    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@google-cloud/speech": "^8.2.1",
    "bullmq": "^6.5.1",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^6.0.0",
    "jsonrepair": "^3.15.0",
    "mongoose": "^9.11.4",
    "pg": "^8.23.1",
    "ts-fsrs": "6.0.0",
    "zod": "^4.6.7",
    "@everlang/contracts": "*"
  }
