    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@google-cloud/speech": "^8.2.1",
    "bullmq": "^6.5.1",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "5.11.1",
    "jsonrepair": "^3.15.0",
    "pg": "^8.23.1",
    "ts-fsrs": "6.0.0",
    "zod": "^4.6.7",
    "@everlang/contracts": "*",
    "typeorm": "1.1.2",
    "reflect-metadata": "0.2.2"
  }
}
