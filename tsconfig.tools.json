{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {"@/*": ["apps/web/*"]}
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "data/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
